# Copy to frontend/.env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_ values are sent to the browser, so only public values go here
# (never the service role key).
# For local Supabase: `supabase status -o env` shows API_URL and ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
# Must match MAX_FILE_MB in backend/.env (the API checks it again anyway).
NEXT_PUBLIC_MAX_FILE_MB=50
# Leave empty when the AI runs on your own computer (Ollama). If backend/.env
# uses an online AI service, put its name here (e.g. Google Gemini): the home
# page then tells visitors that the book's text is sent to that service.
NEXT_PUBLIC_AI_SERVICE=
