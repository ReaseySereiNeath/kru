#!/bin/bash
# Run the parts of Kru. One command per part, each in its own terminal:
#
#   ./kru db        start the database (Supabase, in Docker)
#   ./kru api       start the API             http://localhost:8000
#   ./kru worker    start the worker that summarizes books
#   ./kru web       start the website         http://localhost:3000
#
#   ./kru check     show what is set up and what is running
#   ./kru test      run all the tests and code checks
#   ./kru stop-db   stop the database (your data is kept)
#
# First-time setup is in README.md.

set -e
ROOT="$(cd "$(dirname "$0")" && pwd)"

need_backend() {
  if [ ! -d "$ROOT/backend/.venv" ]; then
    echo "The backend is not set up yet. Run:"
    echo "  cd backend && python3.11 -m venv .venv && source .venv/bin/activate && pip install -r requirements.txt"
    exit 1
  fi
  if [ ! -f "$ROOT/backend/.env" ]; then
    echo "backend/.env is missing. Run: cp backend/.env.example backend/.env   (then see README)"
    exit 1
  fi
  cd "$ROOT/backend"
  source .venv/bin/activate
}

need_frontend() {
  cd "$ROOT/frontend"
  if [ ! -d node_modules ]; then
    echo "Installing the website's packages (first time only)..."
    npm install
  fi
  if [ ! -f .env.local ]; then
    echo "frontend/.env.local is missing. Run: cp frontend/.env.example frontend/.env.local   (then see README)"
    exit 1
  fi
}

# Print one line of the check list: ok "text"  /  bad "text" "how to fix"
ok()  { printf "  \033[32mok\033[0m    %s\n" "$1"; }
bad() { printf "  \033[31mno\033[0m    %s\n        -> %s\n" "$1" "$2"; PROBLEMS=$((PROBLEMS + 1)); }
off() { printf "  --    %s\n        -> %s\n" "$1" "$2"; }

check() {
  PROBLEMS=0
  echo "Setup"
  [ -d "$ROOT/backend/.venv" ] && ok "backend packages (backend/.venv)" \
    || bad "backend packages" "cd backend && python3.11 -m venv .venv && source .venv/bin/activate && pip install -r requirements.txt"
  [ -f "$ROOT/backend/.env" ] && ok "backend/.env" || bad "backend/.env" "cp backend/.env.example backend/.env"
  [ -d "$ROOT/frontend/node_modules" ] && ok "website packages (frontend/node_modules)" \
    || bad "website packages" "cd frontend && npm install"
  [ -f "$ROOT/frontend/.env.local" ] && ok "frontend/.env.local" \
    || bad "frontend/.env.local" "cp frontend/.env.example frontend/.env.local"

  echo "Services Kru needs"
  if curl -s -m 3 http://localhost:11434/api/version > /dev/null; then
    ok "Ollama (the AI model server)"
  else
    bad "Ollama is not running" "brew services start ollama"
  fi
  if docker info > /dev/null 2>&1; then
    ok "Docker"
  else
    bad "Docker is not running" "open OrbStack or Docker Desktop"
  fi
  if curl -s -m 3 -o /dev/null http://127.0.0.1:54321/auth/v1/health; then
    ok "Supabase (database)"
  else
    bad "Supabase is not running" "./kru db"
  fi

  echo "Kru's own parts"
  HEALTH=$(curl -s -m 8 http://localhost:8000/health || true)
  if [ "$HEALTH" = '{"database":"ok","llm":"ok"}' ]; then
    ok "API at http://localhost:8000"
  elif [ -n "$HEALTH" ]; then
    bad "API answers, but something is wrong: $HEALTH" "see 'If something goes wrong' in README.md"
  else
    off "API is not running" "./kru api"
  fi
  if pgrep -f "worker.run" > /dev/null; then
    ok "worker"
  else
    off "worker is not running (uploaded books will wait in line)" "./kru worker"
  fi
  if curl -s -m 3 -o /dev/null http://localhost:3000; then
    ok "website at http://localhost:3000"
  else
    off "website is not running" "./kru web"
  fi

  echo
  if [ "$PROBLEMS" -eq 0 ]; then
    echo "Nothing is missing. Start any part marked '--' in its own terminal."
  else
    echo "$PROBLEMS thing(s) to fix first (marked 'no')."
    exit 1
  fi
}

case "${1:-}" in
  db)
    cd "$ROOT"
    if ! docker info > /dev/null 2>&1; then
      echo "Docker is not running. Open OrbStack or Docker Desktop, then run ./kru db again."
      exit 1
    fi
    supabase start
    ;;
  stop-db)
    cd "$ROOT" && supabase stop
    ;;
  api)
    need_backend
    exec uvicorn app.main:app --reload --port 8000
    ;;
  worker)
    need_backend
    exec python -m worker.run
    ;;
  web)
    need_frontend
    exec npm run dev
    ;;
  check)
    check
    ;;
  test)
    need_backend
    echo "== Backend tests"
    pytest -q
    need_frontend
    echo "== Website code checks"
    npm run lint
    npx tsc --noEmit
    echo "All good."
    ;;
  *)
    # Print the comment block at the top of this file as the help text.
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
