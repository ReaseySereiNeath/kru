# Copy this file to backend/.env and edit it.  cp .env.example .env
# Never commit backend/.env (it is in .gitignore).

# ---------- AI model ----------
# Which AI service writes the summaries:
#   ollama      on this computer (default, private, free)
#   openrouter  online, free models only (ids ending in ":free")   https://openrouter.ai
#   groq        online, free tier                                   https://console.groq.com
#   gemini      online, Google AI Studio free tier                  https://aistudio.google.com
#   anthropic   online, Claude. PAID: needs LLM_ALLOW_PAID=true     https://console.anthropic.com
#   custom      any other OpenAI-compatible server (set LLM_BASE_URL)
# With an online service, the book's text is sent to that service. See README.
LLM_PROVIDER=ollama
# Kru refuses paid services (Claude, paid OpenRouter models) unless this is true.
LLM_ALLOW_PAID=false
# Claude only: how hard it thinks: low, medium, or high. Empty = the model's default.
# Lower effort is cheaper and faster.
LLM_EFFORT=
LLM_API_KEY=ollama                 # Ollama ignores it; online services need your key
LLM_MODEL_CHUNK=qwen2.5:14b        # Ollama: a name from `ollama list`
LLM_MODEL_FINAL=qwen2.5:14b        # same model, or a larger one
# Only for Ollama on another computer, or LLM_PROVIDER=custom:
# LLM_BASE_URL=http://localhost:11434/v1

# Context window in tokens. For Ollama, Ollama must load at least this much
# (check with: python -m pipeline.check_llm). See README "Context length".
# Online models usually have more; 16384 is still a good, safe value.
LLM_CONTEXT_TOKENS=16384
LLM_TEMPERATURE=0.3

# Tokens kept free for the answer. The final summary is long, so it needs more.
LLM_ANSWER_RESERVE_TOKENS=2500
LLM_FINAL_ANSWER_RESERVE_TOKENS=4500

# Example: Claude (paid). Each 300-page book costs a few cents to about $1 (see README).
# LLM_PROVIDER=anthropic
# LLM_ALLOW_PAID=true
# LLM_API_KEY=<your key from https://console.anthropic.com>
# LLM_MODEL_CHUNK=claude-haiku-5-5
# LLM_MODEL_FINAL=claude-sonnet-5-5

# Example: Google Gemini's free tier instead of Ollama
# LLM_PROVIDER=gemini
# LLM_API_KEY=<your key from https://aistudio.google.com/apikey>
# LLM_MODEL_CHUNK=<a model name from python -m pipeline.check_llm>
# LLM_MODEL_FINAL=<same>

# ---------- Pipeline ----------
CHUNK_TARGET_WORDS=4000            # try values between 2000 and 5000
CHUNK_NOTES_MAX_WORDS=250
MERGE_NOTES_MAX_WORDS=400
MAX_WORDS=200000                   # about 500 pages
MAX_FILE_MB=50

# ---------- Worker ----------
WORKER_CONCURRENCY=1               # books processed at the same time

# ---------- Supabase (database, logins, file storage) ----------
# For local Supabase, run `supabase status` to see these values (see README).
# The service role key can read and change everything: keep it secret, and
# never put it in the frontend.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- API ----------
FRONTEND_ORIGIN=http://localhost:3000   # the website allowed to call the API
BOOKS_PER_DAY=3                         # uploads per user per 24 hours; 0 = no limit
