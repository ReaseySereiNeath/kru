# Copy this file to backend/.env and edit it.  cp .env.example .env
# Never commit backend/.env (it is in .gitignore).

# ---------- LLM (default: Ollama on this computer) ----------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama                 # Ollama ignores it, but the client needs a value
LLM_MODEL_CHUNK=qwen2.5:14b        # a name from `ollama list`
LLM_MODEL_FINAL=qwen2.5:14b        # same model, or a larger one if your machine allows

# Context window in tokens. Ollama must load at least this much
# (check with: python -m pipeline.check_llm). See README "Context length".
LLM_CONTEXT_TOKENS=16384
LLM_TEMPERATURE=0.3

# Tokens kept free for the answer. The final summary is long, so it needs more.
LLM_ANSWER_RESERVE_TOKENS=2500
LLM_FINAL_ANSWER_RESERVE_TOKENS=4500

# ---------- Optional: OpenRouter free models instead of Ollama ----------
# Free models have strict daily request limits (a long book may not fit in one day).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...            # your OpenRouter key
# LLM_MODEL_CHUNK=<model id ending in :free>
# LLM_MODEL_FINAL=<model id ending in :free>

# ---------- Pipeline ----------
CHUNK_TARGET_WORDS=4000            # try values between 2000 and 5000
CHUNK_NOTES_MAX_WORDS=250
MERGE_NOTES_MAX_WORDS=400
MAX_WORDS=200000                   # about 500 pages
MAX_FILE_MB=50

# ---------- Worker ----------
WORKER_CONCURRENCY=1               # books processed at the same time

# ---------- Supabase (needed from Phase 4) ----------
# For local Supabase, run `supabase status` to see these values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
